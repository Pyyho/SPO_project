# Copy to .env and supply your database URL. Do not commit .env.
DATABASE_URL=postgresql://trip_app:replace_me@localhost:5432/trips
DB_SCHEMA=public
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_characters
APP_ORIGIN=http://localhost:3000
API_HOST=127.0.0.1
API_PORT=3001
API_INTERNAL_URL=http://127.0.0.1:3001
COOKIE_SECURE=false
# Enable only when using an HTTPS reverse proxy you control.
TRUST_PROXY=false
DB_SSL=false
# Set true only in an environment that is allowed to reset the demo data.
ALLOW_DEMO_BOOTSTRAP=false
DEMO_PASSWORD=replace_with_a_demo_password_of_at_least_12_characters
# Used only by the Docker Compose PostgreSQL service.
POSTGRES_PASSWORD=replace_with_a_separate_database_password

# These values must match CHECK/ENUM constraints in your existing database.
STATUS_DRAFT=draft
STATUS_SUBMITTED=submitted
STATUS_APPROVAL=in_approval
STATUS_APPROVED=approved
STATUS_REJECTED=rejected
STATUS_COMPLETED=completed
STEP_PENDING=pending
STEP_APPROVED=approved
STEP_REJECTED=rejected
