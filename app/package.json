{
  "name": "service-trips",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch --env-file=.env server/index.mjs\" \"next dev --hostname 127.0.0.1\"",
    "build": "next build",
    "start": "concurrently -k -n api,web \"node server/index.mjs\" \"next start --hostname 0.0.0.0\"",
    "test": "node --test tests/*.test.mjs",
    "db:check": "node --env-file=.env server/check-schema.mjs",
    "db:bootstrap": "node --env-file=.env scripts/bootstrap.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "connect-redis": "^9.0.0",
    "concurrently": "^9.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "next": "^16.0.0",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "redis": "^5.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.0"
  }
}
